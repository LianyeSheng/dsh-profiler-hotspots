# ---- Dependencies ----
node_modules/

# ---- Build output (regenerate with `npm run build`) ----
dist/
*.tsbuildinfo

# ---- Test / coverage output ----
coverage/
.nyc_output/
.vitest/
*.lcov

# ---- Caches ----
.cache/
.eslintcache
.stylelintcache
.parcel-cache/
.npm/
.pnpm-store/

# ---- Logs ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---- Local environment / secrets ----
.env
.env.*
!.env.example

# ---- Editor / OS noise ----
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
*~

# ---- Scratch / temp files ----
.tmp/
tmp/
*.tgz
*.pid

# ---- pnpm content-addressable store (kept inside the workspace) ----
.pnpm-store/

# ---- Python gate caches ----
__pycache__/
*.pyc
